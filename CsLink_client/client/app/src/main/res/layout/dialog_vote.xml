<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="22dp">

    <!-- 1. 顶部标题与状态说明 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="随堂单选投票"
        android:textColor="#15803D"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvVoteTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="题目加载中..."
        android:textColor="#1F2937"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvVoteStatusHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="请点击下方选项提交答案"
        android:textColor="#6B7280"
        android:textSize="12sp" />

    <!-- 2. 学生选项按钮组 (A / B / C / D) -->
    <LinearLayout
        android:id="@+id/layoutVoteButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnVoteA"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#E5E7EB"
            android:text="A"
            android:textColor="#1F2937"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVoteB"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#E5E7EB"
            android:text="B"
            android:textColor="#1F2937"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVoteC"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#E5E7EB"
            android:text="C"
            android:textColor="#1F2937"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVoteD"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:backgroundTint="#E5E7EB"
            android:text="D"
            android:textColor="#1F2937"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. 实时票数与占比统计区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#F9FAFB"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvVoteTotalCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="实时统计 (共 0 人参与)"
            android:textColor="#374151"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="选项 A：0 票 (0%)"
            android:textColor="#4B5563"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvStatB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="选项 B：0 票 (0%)"
            android:textColor="#4B5563"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvStatC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="选项 C：0 票 (0%)"
            android:textColor="#4B5563"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvStatD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="选项 D：0 票 (0%)"
            android:textColor="#4B5563"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 4. 底部操作按钮区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStopVoteTeacher"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#EF4444"
            android:text="结束投票并公布"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnCloseVoteDialog"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="#E5E7EB"
            android:text="关闭窗口"
            android:textColor="#374151"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>