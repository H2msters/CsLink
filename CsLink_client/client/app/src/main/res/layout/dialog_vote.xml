<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="22dp">

    <!-- 1. 顶部标题与说明 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="班级投票"
        android:textColor="#15803D"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvVoteTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="题目加载中..."
        android:textColor="#1F2937"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvVoteStatusHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="请点击下方选项提交答案"
        android:textColor="#6B7280"
        android:textSize="12sp" />

    <!-- 2. 学生作答选项按钮组 -->
    <LinearLayout
        android:id="@+id/layoutVoteButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnVoteA"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#E5E7EB"
            android:text="A"
            android:textColor="#1F2937"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVoteB"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#E5E7EB"
            android:text="B"
            android:textColor="#1F2937"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVoteC"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#E5E7EB"
            android:text="C"
            android:textColor="#1F2937"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVoteD"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:backgroundTint="#E5E7EB"
            android:text="D"
            android:textColor="#1F2937"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. 统计区容器：在学生答题未截止时整体隐藏防跟风，截止后展示 -->
    <LinearLayout
        android:id="@+id/layoutVoteStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#F9FAFB"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvVoteTotalCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="实时统计 (共 0 人参与)"
            android:textColor="#374151"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- 选项 A 统计与进度条 -->
        <TextView
            android:id="@+id/tvStatA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="选项 A：0 票 (0%)"
            android:textColor="#4B5563"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/pbStatA"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#1E88E5" />

        <!-- 选项 B 统计与进度条 -->
        <TextView
            android:id="@+id/tvStatB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="选项 B：0 票 (0%)"
            android:textColor="#4B5563"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/pbStatB"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#10B981" />

        <!-- 选项 C 统计与进度条 -->
        <TextView
            android:id="@+id/tvStatC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="选项 C：0 票 (0%)"
            android:textColor="#4B5563"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/pbStatC"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#F59E0B" />

        <!-- 选项 D 统计与进度条 -->
        <TextView
            android:id="@+id/tvStatD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="选项 D：0 票 (0%)"
            android:textColor="#4B5563"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/pbStatD"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#8B5CF6" />
    </LinearLayout>

    <!-- 4. 底部操作按钮栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStopVoteTeacher"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#EF4444"
            android:text="结束投票并公布"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnCloseVoteDialog"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="#E5E7EB"
            android:text="关闭窗口"
            android:textColor="#374151"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:gravity="center" />
    </LinearLayout>

</LinearLayout>