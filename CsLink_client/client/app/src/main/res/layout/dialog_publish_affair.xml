<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/tvDialogAffairTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="发布班级事务"
        android:textColor="#1F2937"
        android:textSize="18sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgAffairType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbTypeNotice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="班级通知"
            android:textColor="#1F2937"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbTypeHomework"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="班级作业"
            android:textColor="#1F2937"
            android:textSize="14sp" />
    </RadioGroup>

    <EditText
        android:id="@+id/etAffairTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="输入事务标题"
        android:textSize="14sp" />

    <!-- 截止日期选择栏：点击弹出日历时间面板，右侧支持一键清空 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etAffairDeadline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:cursorVisible="false"
            android:focusable="false"
            android:hint="点击设置截止时间 (可选)"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnClearDeadline"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#F3F4F6"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="清空"
            android:textColor="#6B7280"
            android:textSize="11sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/etAffairContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="top|start"
        android:hint="输入具体内容与要求..."
        android:minLines="3"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelAffair"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#E5E7EB"
            android:text="取消"
            android:textColor="#374151"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSubmitAffair"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="#1E88E5"
            android:text="立即发布"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>