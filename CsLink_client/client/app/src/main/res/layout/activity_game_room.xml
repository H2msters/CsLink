<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/roomRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:fitsSystemWindows="true">

    <!-- 1. 顶部协作室标题栏 -->
    <RelativeLayout
        android:id="@+id/layoutRoomHeader"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="#1E88E5"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvRoomHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/layoutRightActions"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="协作研讨组"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutRightActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDisbandRoom"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:backgroundTint="#EF4444"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingTop="0dp"
                android:paddingEnd="8dp"
                android:paddingBottom="0dp"
                android:text="解散"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:visibility="gone"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btnRoomMembers"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="5dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:backgroundTint="#1565C0"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingTop="0dp"
                android:paddingEnd="8dp"
                android:paddingBottom="0dp"
                android:text="组员 (0人)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                tools:ignore="TouchTargetSizeCheck" />

            <Button
                android:id="@+id/btnBackToLobby"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="5dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:backgroundTint="#374151"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingTop="0dp"
                android:paddingEnd="8dp"
                android:paddingBottom="0dp"
                android:text="返回"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                tools:ignore="TouchTargetSizeCheck" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 2. 中间：讨论消息流 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRoomChat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/layoutRoomHeader"
        app:layout_constraintBottom_toTopOf="@id/layoutRoomInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 3. 底部输入控制栏 -->
    <LinearLayout
        android:id="@+id/layoutRoomInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        app:layout_constraintBottom_toTopOf="@id/layoutRoomToolPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etRoomMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="请输入文本"
            android:maxLines="3"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSendRoomMsg"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:minWidth="48dp"
            android:minHeight="0dp"
            android:backgroundTint="#1E88E5"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingTop="0dp"
            android:paddingEnd="14dp"
            android:paddingBottom="0dp"
            android:text="发送"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            tools:ignore="HardcodedText,TouchTargetSizeCheck" />

        <Button
            android:id="@+id/btnToggleRoomToolPanel"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:minWidth="48dp"
            android:minHeight="0dp"
            android:backgroundTint="#9CA3AF"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingTop="0dp"
            android:paddingEnd="14dp"
            android:paddingBottom="0dp"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            tools:ignore="HardcodedText,TouchTargetSizeCheck" />
    </LinearLayout>

    <!-- 4. 底部扩展插件抽屉（横向滑动容纳拍摄、相册、猜拳、白板） -->
    <HorizontalScrollView
        android:id="@+id/layoutRoomToolPanel"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:background="#F9FAFB"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- 插件 1：随堂拍照 -->
            <LinearLayout
                android:id="@+id/itemToolCamera"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnToolCameraAction"
                    android:layout_width="52dp"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="#EFF6FF"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="拍摄"
                    android:textColor="#1E88E5"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:ignore="TouchTargetSizeCheck" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="拍摄发图"
                    android:textColor="#4B5563"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 插件 2：相册选择 -->
            <LinearLayout
                android:id="@+id/itemToolGallery"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnToolGalleryAction"
                    android:layout_width="52dp"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="#F3E8FF"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="相册"
                    android:textColor="#7C3AED"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:ignore="TouchTargetSizeCheck" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="相册选择"
                    android:textColor="#4B5563"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 插件 3：决策猜拳 -->
            <LinearLayout
                android:id="@+id/itemToolRps"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnLaunchRpsTool"
                    android:layout_width="52dp"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="#E0F2FE"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="猜拳"
                    android:textColor="#0369A1"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:ignore="TouchTargetSizeCheck" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="决策猜拳"
                    android:textColor="#4B5563"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 插件 4：协同草稿 -->
            <LinearLayout
                android:id="@+id/itemToolCanvas"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnToolCanvasAction"
                    android:layout_width="52dp"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="#DCFCE7"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="白板"
                    android:textColor="#15803D"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:ignore="TouchTargetSizeCheck" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="协同草稿"
                    android:textColor="#4B5563"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>