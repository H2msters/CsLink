<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/roomRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:fitsSystemWindows="true">

    <!-- 1. 顶部协作室标题栏 -->
    <RelativeLayout
        android:id="@+id/layoutRoomHeader"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="#1E88E5"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/layoutRightActions"
            android:layout_marginEnd="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRoomHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="协作研讨组"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDisbandRoom"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:minWidth="48dp"
                android:backgroundTint="#EF4444"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="解散"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutRightActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRoomMembers"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#1565C0"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="组员 (0人)"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnBackToLobby"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:backgroundTint="#374151"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="返回"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 2. 中间：讨论消息流 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRoomChat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/layoutRoomHeader"
        app:layout_constraintBottom_toTopOf="@id/layoutRoomInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 3. 底部输入控制栏 -->
    <LinearLayout
        android:id="@+id/layoutRoomInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        app:layout_constraintBottom_toTopOf="@id/layoutRoomToolPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etRoomMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="在小组内交流研讨..."
            android:maxLines="3"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSendRoomMsg"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#1E88E5"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="发送"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnToggleRoomToolPanel"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#E5E7EB"
            android:text="+"
            android:textColor="#374151"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. 底部扩展插件抽屉 -->
    <LinearLayout
        android:id="@+id/layoutRoomToolPanel"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:background="#F9FAFB"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 插件 1：决策猜拳 -->
        <LinearLayout
            android:id="@+id/itemToolRps"
            android:layout_width="76dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnLaunchRpsTool"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:backgroundTint="#E0F2FE"
                android:clickable="false"
                android:focusable="false"
                android:text="猜拳"
                android:textColor="#0369A1"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="决策猜拳"
                android:textColor="#4B5563"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 插件 2：协同草稿 -->
        <LinearLayout
            android:id="@+id/itemToolCanvas"
            android:layout_width="76dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnToolCanvasAction"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:backgroundTint="#DCFCE7"
                android:clickable="false"
                android:focusable="false"
                android:text="白板"
                android:textColor="#15803D"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="协同草稿"
                android:textColor="#4B5563"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>