<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pageChatLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:orientation="vertical">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <!-- 底部输入栏 -->
    <LinearLayout
        android:id="@+id/layoutInputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="输入讨论内容..."
            android:maxLines="3"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:textColor="#0F172A"
            android:textSize="14sp"
            tools:ignore="Autofill,HardcodedText,TextFields" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minWidth="52dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="14dp"
            android:paddingTop="0dp"
            android:paddingEnd="14dp"
            android:paddingBottom="0dp"
            android:gravity="center"
            android:layout_marginStart="6dp"
            android:backgroundTint="#1E88E5"
            android:text="发送"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            tools:ignore="HardcodedText,TouchTargetSizeCheck" />

        <Button
            android:id="@+id/btnToggleMorePanel"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minWidth="42dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="10dp"
            android:paddingTop="0dp"
            android:paddingEnd="10dp"
            android:paddingBottom="0dp"
            android:gravity="center"
            android:layout_marginStart="6dp"
            android:backgroundTint="#64748B"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            tools:ignore="HardcodedText,TouchTargetSizeCheck" />
    </LinearLayout>

    <!-- 扩展工具栏：矢量图标 + 精简2字标签 -->
    <LinearLayout
        android:id="@+id/layoutMorePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <!-- 1. 拍摄 -->
                <LinearLayout
                    android:id="@+id/itemPanelCamera"
                    android:layout_width="68dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnPanelCamera"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:background="@drawable/bg_icon_box"
                        android:backgroundTint="#E0F2FE"
                        android:drawableTop="@drawable/ic_vec_camera"
                        android:paddingTop="12dp"
                        android:text=""
                        tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="拍摄"
                        android:textColor="#334155"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 2. 相册 -->
                <LinearLayout
                    android:layout_width="68dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnPickImage"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:background="@drawable/bg_icon_box"
                        android:backgroundTint="#F3E8FF"
                        android:drawableTop="@drawable/ic_vec_gallery"
                        android:paddingTop="12dp"
                        android:text=""
                        tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="相册"
                        android:textColor="#334155"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 3. 抢答 -->
                <LinearLayout
                    android:id="@+id/itemPanelStartBuzz"
                    android:layout_width="68dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnPanelBuzzAction"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:background="@drawable/bg_icon_box"
                        android:backgroundTint="#FEE2E2"
                        android:drawableTop="@drawable/ic_vec_buzz"
                        android:paddingTop="12dp"
                        android:text=""
                        tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="抢答"
                        android:textColor="#334155"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 4. 点名 -->
                <LinearLayout
                    android:id="@+id/itemPanelRandomPick"
                    android:layout_width="68dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnPanelRandomPick"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:background="@drawable/bg_icon_box"
                        android:backgroundTint="#F3E8FF"
                        android:drawableTop="@drawable/ic_vec_pick"
                        android:paddingTop="12dp"
                        android:text=""
                        tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="点名"
                        android:textColor="#334155"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 5. 测验 -->
                <LinearLayout
                    android:id="@+id/itemPanelStartVote"
                    android:layout_width="68dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnPanelStartVote"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:background="@drawable/bg_icon_box"
                        android:backgroundTint="#DCFCE7"
                        android:drawableTop="@drawable/ic_vec_vote"
                        android:paddingTop="12dp"
                        android:text=""
                        tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="投票"
                        android:textColor="#334155"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 6. 禁言 -->
                <LinearLayout
                    android:id="@+id/itemPanelGlobalMute"
                    android:layout_width="68dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnPanelGlobalMute"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:background="@drawable/bg_icon_box"
                        android:backgroundTint="#FEF3C7"
                        android:drawableTop="@drawable/ic_vec_mute"
                        android:paddingTop="12dp"
                        android:text=""
                        tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

                    <TextView
                        android:id="@+id/tvPanelGlobalMuteLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="禁言"
                        android:textColor="#334155"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 7. 锁屏 -->
                <LinearLayout
                    android:id="@+id/itemPanelLockScreen"
                    android:layout_width="68dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnPanelLockScreen"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:background="@drawable/bg_icon_box"
                        android:backgroundTint="#E2E8F0"
                        android:drawableTop="@drawable/ic_vec_lock"
                        android:paddingTop="12dp"
                        android:text=""
                        tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

                    <TextView
                        android:id="@+id/tvPanelLockScreenLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="锁屏"
                        android:textColor="#334155"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

</LinearLayout>