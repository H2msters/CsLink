<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutProfileContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:orientation="vertical"
    android:padding="16dp"
    android:visibility="gone">

    <!-- 1. 用户个人卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="1dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/ivUserAvatar"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:id="@+id/tvProfileNickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="姓名：未设置"
            android:textColor="#1F2937"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <!-- 精简按钮：修改姓名 -->
        <Button
            android:id="@+id/btnEditProfileName"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:backgroundTint="#F3F4F6"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="修改姓名"
            android:textColor="#374151"
            android:textSize="13sp"
            tools:ignore="HardcodedText,TouchTargetSizeCheck" />
    </LinearLayout>

    <!-- 2. 网络与服务状态卡片 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:text="服务连接状态"
        android:textColor="#6B7280"
        android:textSize="13sp"
        tools:ignore="HardcodedText" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="1dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvProfileStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="5dp"
            android:text="服务器节点：192.168.137.1:8000\n当前权限：学生端\n网络状态：已连接"
            android:textColor="#4B5563"
            android:textSize="13sp"
            tools:ignore="HardcodedText" />

        <!-- 精简按钮：重新连接 -->
        <Button
            android:id="@+id/btnProfileReconnect"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:backgroundTint="#10B981"
            android:text="重新连接"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            tools:ignore="HardcodedText,TouchTargetSizeCheck" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 3. 底层跳转设置按钮：系统设置 -->
    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="12dp"
        android:minHeight="48dp"
        android:backgroundTint="#1E88E5"
        android:text="系统设置"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        tools:ignore="HardcodedText,TouchTargetSizeCheck" />

</LinearLayout>