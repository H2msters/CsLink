<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="4dp"
    android:padding="14dp"
    android:elevation="1dp">

    <!-- 1. 顶部：类型标签 + 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAffairTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#DBEAFE"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="班级通知"
            android:textColor="#1E40AF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAffairTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="事务标题"
            android:textColor="#1F2937"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. 发布者与时间 -->
    <TextView
        android:id="@+id/tvAffairMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="发布人：教师 · 19:30"
        android:textColor="#9CA3AF"
        android:textSize="11sp" />

    <!-- 3. 正文内容 -->
    <TextView
        android:id="@+id/tvAffairContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3dp"
        android:text="事务详情内容..."
        android:textColor="#374151"
        android:textSize="14sp" />

    <!-- 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:background="#F3F4F6" />

    <!-- 4. 底部回执操作栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvConfirmedStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="已确认人数：0 人"
            android:textColor="#6B7280"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnConfirmAffair"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:backgroundTint="#1E88E5"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="我已确认"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </RelativeLayout>

</LinearLayout>