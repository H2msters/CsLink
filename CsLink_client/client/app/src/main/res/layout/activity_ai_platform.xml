<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/aiPlatformRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 1. 顶部导航栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#1E88E5"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/btnAiBack"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_centerVertical="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="14dp"
            android:paddingTop="0dp"
            android:paddingEnd="14dp"
            android:paddingBottom="0dp"
            android:gravity="center"
            android:backgroundTint="#1565C0"
            android:text="返回"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            tools:ignore="HardcodedText,TouchTargetSizeCheck" />

        <TextView
            android:id="@+id/tvAiHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="AI 平台"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAiUserScore"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="#1565C0"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="积分: 0"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAiConfig"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="12dp"
                android:paddingTop="0dp"
                android:paddingEnd="12dp"
                android:paddingBottom="0dp"
                android:gravity="center"
                android:backgroundTint="#1565C0"
                android:text="API 管理"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:visibility="gone"
                tools:ignore="HardcodedText,TouchTargetSizeCheck" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 2. 国内主流大模型下拉切换栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/ivSelectedModelIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_model_qwen" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="当前模型："
            android:textColor="#64748B"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spAiModelSelector"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:spinnerMode="dropdown" />

        <Button
            android:id="@+id/btnAiClearChat"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="10dp"
            android:paddingTop="0dp"
            android:paddingEnd="10dp"
            android:paddingBottom="0dp"
            android:gravity="center"
            android:backgroundTint="#F1F5F9"
            android:text="清空对话"
            android:textColor="#475569"
            android:textSize="11sp"
            tools:ignore="HardcodedText,TouchTargetSizeCheck" />
    </LinearLayout>

    <!-- 3. 对话消息流 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAiChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="10dp"
        android:paddingBottom="10dp" />

    <!-- 4. 底部提问输入栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <EditText
            android:id="@+id/etAiPrompt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="输入提问内容..."
            android:maxLines="4"
            android:padding="8dp"
            android:textColor="#0F172A"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnAiSend"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:minWidth="52dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="14dp"
            android:paddingTop="0dp"
            android:paddingEnd="14dp"
            android:paddingBottom="0dp"
            android:gravity="center"
            android:backgroundTint="#1E88E5"
            android:text="发送"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            tools:ignore="HardcodedText,TouchTargetSizeCheck" />
    </LinearLayout>

</LinearLayout>