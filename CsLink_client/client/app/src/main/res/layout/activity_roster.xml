<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rosterRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical">

    <!-- 顶栏导航（右侧新增考勤日历入口） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#1E88E5"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:backgroundTint="#1976D2"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="返回"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            tools:ignore="HardcodedText,TouchTargetSizeCheck" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="班级成员"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/btnAttendanceCalendar"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:backgroundTint="#1565C0"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="考勤日历"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            tools:ignore="HardcodedText,TouchTargetSizeCheck" />
    </LinearLayout>

    <!-- 顶部班级信息与分段排序卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="1dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <!-- 班级全称与更名操作 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvClassroomName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="班级：未连接"
                android:textColor="#0F172A"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/btnEditClassName"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:backgroundTint="#1E88E5"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="修改班级"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:visibility="gone"
                tools:ignore="HardcodedText,TouchTargetSizeCheck" />
        </LinearLayout>

        <!-- 统计信息与分段排序胶囊切换栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRosterSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="共 0 人 · 0 在线"
                android:textColor="#64748B"
                android:textSize="13sp"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#F1F5F9"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:id="@+id/btnSortDefault"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="#1E88E5"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="默认"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/btnSortScore"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="积分榜"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 成员列表 -->
    <ListView
        android:id="@+id/lvRosterMembers"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="#F1F5F9"
        android:dividerHeight="1dp"
        android:listSelector="@android:color/transparent" />

</LinearLayout>