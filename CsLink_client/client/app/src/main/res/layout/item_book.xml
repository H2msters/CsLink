<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#FFFFFF"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:layout_marginBottom="1dp">

    <!-- 文件类型图标徽章 -->
    <LinearLayout
        android:layout_width="38dp"
        android:layout_height="46dp"
        android:background="#FEE2E2"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PDF"
            android:textColor="#DC2626"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <!-- 书籍名称与元信息 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvBookTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="书籍名称.pdf"
            android:textColor="#1F2937"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/tvBookMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="上传者: 教师 · 2.5 MB"
            android:textColor="#4B5563"
            android:textSize="11sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <!-- 教师删除按钮：补充最小触控热区与属性忽略 -->
    <Button
        android:id="@+id/btnDeleteBook"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:layout_marginEnd="6dp"
        android:backgroundTint="#FEE2E2"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="删除"
        android:textColor="#DC2626"
        android:textSize="11sp"
        android:visibility="gone"
        tools:ignore="HardcodedText,TouchTargetSizeCheck" />

    <!-- 核心阅读按钮：消除 TouchTargetSizeCheck 红色错误 -->
    <Button
        android:id="@+id/btnReadBook"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:backgroundTint="#1E88E5"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="阅读"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        tools:ignore="HardcodedText,TouchTargetSizeCheck" />

</LinearLayout>