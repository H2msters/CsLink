<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 1. 顶部标题与状态 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="小组协同白板草稿"
            android:textColor="#15803D"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCanvasSyncStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="组内实时同步中"
            android:textColor="#64748B"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 2. 画笔颜色与工具选择栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPenBlack"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#1E293B"
            android:padding="0dp"
            android:text="黑笔"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnPenRed"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#EF4444"
            android:padding="0dp"
            android:text="红笔"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnPenBlue"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#2563EB"
            android:padding="0dp"
            android:text="蓝笔"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnPenGreen"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#10B981"
            android:padding="0dp"
            android:text="绿笔"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnPenEraser"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:backgroundTint="#E2E8F0"
            android:padding="0dp"
            android:text="橡皮"
            android:textColor="#334155"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 3. 核心协同画布区域（带浅色外框） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="10dp"
        android:background="#CBD5E1"
        android:padding="1.5dp">

        <cn.edu.hbuas.coursetest.CollaborativeCanvasView
            android:id="@+id/collaborativeCanvasView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- 4. 底部操作栏：清空、发送到讨论流、关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnClearCanvas"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#FEE2E2"
            android:text="清空画板"
            android:textColor="#DC2626"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnShareCanvasToChat"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#1E88E5"
            android:text="发送到讨论"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnCloseCanvas"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#E2E8F0"
            android:text="关闭"
            android:textColor="#334155"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>