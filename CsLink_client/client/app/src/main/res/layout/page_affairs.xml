<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pageAffairsLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:orientation="vertical"
    android:padding="12dp"
    android:visibility="gone">

    <!-- 顶部标题与发布栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvAffairsSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="班级事务"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/btnPublishAffair"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="14dp"
            android:paddingTop="0dp"
            android:paddingEnd="14dp"
            android:paddingBottom="0dp"
            android:gravity="center"
            android:backgroundTint="#1E88E5"
            android:text="新建发布"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone"
            tools:ignore="HardcodedText,TouchTargetSizeCheck" />
    </LinearLayout>

    <!-- 分类切换栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btnFilterNotice"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:gravity="center"
                android:backgroundTint="#1E88E5"
                android:text="班级通知"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                tools:ignore="HardcodedText,TouchTargetSizeCheck" />

            <View
                android:id="@+id/badgeNoticeDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="10dp"
                android:elevation="8dp"
                android:background="@drawable/shape_red_dot"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btnFilterHomework"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:gravity="center"
                android:backgroundTint="#E2E8F0"
                android:text="班级作业"
                android:textColor="#475569"
                android:textSize="13sp"
                tools:ignore="HardcodedText,TouchTargetSizeCheck" />

            <View
                android:id="@+id/badgeHomeworkDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="10dp"
                android:elevation="8dp"
                android:background="@drawable/shape_red_dot"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- 事务列表与空状态提示 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAffairs"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvEmptyAffairs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="暂无事项"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:visibility="gone"
            tools:ignore="HardcodedText" />
    </FrameLayout>

</LinearLayout>