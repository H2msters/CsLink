<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pageAffairsLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:orientation="vertical"
    android:padding="12dp"
    android:visibility="gone">

    <!-- 顶部统计与发布栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvAffairsSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="班级事务与作业"
            android:textColor="#1F2937"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <Button
            android:id="@+id/btnPublishAffair"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:backgroundTint="#1E88E5"
            android:text="发布事务"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone"
            tools:ignore="HardcodedText,TouchTargetSizeCheck" />
    </LinearLayout>

    <!-- 分类切换栏（班级通知 & 班级作业 均带独立未读红点） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <!-- 班级通知 + 红点 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btnFilterNotice"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:minHeight="48dp"
                android:backgroundTint="#1E88E5"
                android:text="班级通知"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                tools:ignore="HardcodedText,TouchTargetSizeCheck" />

            <View
                android:id="@+id/badgeNoticeDot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="10dp"
                android:elevation="8dp"
                android:background="@drawable/shape_red_dot"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 班级作业 + 红点 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btnFilterHomework"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:minHeight="48dp"
                android:backgroundTint="#E5E7EB"
                android:text="班级作业"
                android:textColor="#4B5563"
                android:textSize="13sp"
                tools:ignore="HardcodedText,TouchTargetSizeCheck" />

            <View
                android:id="@+id/badgeHomeworkDot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="10dp"
                android:elevation="8dp"
                android:background="@drawable/shape_red_dot"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- 事务列表与空状态提示 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAffairs"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvEmptyAffairs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="暂无班级通知"
            android:textColor="#9CA3AF"
            android:textSize="14sp"
            android:visibility="gone"
            tools:ignore="HardcodedText" />
    </FrameLayout>

</LinearLayout>