<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pageAffairsLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9">

    <!-- 1. 顶部操作栏 -->
    <LinearLayout
        android:id="@+id/layoutAffairsTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvAffairsSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="班级事务大厅"
            android:textColor="#1F2937"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPublishAffair"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#1E88E5"
            android:text="+ 发布新事务"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 2. 二级分类切换栏：【班级通知】 vs 【随堂作业】 -->
    <LinearLayout
        android:id="@+id/layoutAffairsSegment"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toBottomOf="@id/layoutAffairsTopBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnFilterNotice"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#1E88E5"
            android:text="班级通知"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnFilterHomework"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="#E5E7EB"
            android:text="班级作业"
            android:textColor="#4B5563"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 3. 事务列表区域 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAffairs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/layoutAffairsSegment"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 空列表占位 -->
    <TextView
        android:id="@+id/tvEmptyAffairs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="当前类别暂无内容"
        android:textColor="#9CA3AF"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutAffairsSegment"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>