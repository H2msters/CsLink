<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pageAffairsLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9">

    <!-- 1. 顶部操作栏（包含事务统计与教师专属发布按钮） -->
    <LinearLayout
        android:id="@+id/layoutAffairsTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvAffairsSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="班级事务与作业"
            android:textColor="#1F2937"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPublishAffair"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#1E88E5"
            android:text="+ 发布新事务"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 2. 事务列表滚动区 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAffairs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/layoutAffairsTopBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 3. 空列表占位提示 -->
    <TextView
        android:id="@+id/tvEmptyAffairs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="暂无班级事务或作业通知"
        android:textColor="#9CA3AF"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutAffairsTopBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>