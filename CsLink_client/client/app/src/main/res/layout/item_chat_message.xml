<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- 1. 系统通知消息 -->
    <TextView
        android:id="@+id/tvSystemNotice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="#DDE3EA"
        android:paddingStart="10dp"
        android:paddingTop="3dp"
        android:paddingEnd="10dp"
        android:paddingBottom="3dp"
        android:textColor="#555555"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- 2. 他人消息（靠左） -->
    <LinearLayout
        android:id="@+id/layoutOtherMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top|start"
        android:orientation="horizontal"
        android:visibility="visible">

        <ImageView
            android:id="@+id/ivOtherAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#E3F2FD"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher_round"
            android:contentDescription="他人头像" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvOtherSender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="某同学"
                    android:textColor="#6B7280"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvOtherTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="12:00"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvOtherContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_bubble_other"
                android:maxWidth="260dp"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:text="他人文本"
                android:textColor="#1F2937"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/ivOtherImage"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:adjustViewBounds="true"
                android:contentDescription="接收到的图片"
                android:maxHeight="220dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. 自己消息（靠右） -->
    <LinearLayout
        android:id="@+id/layoutMyMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top|end"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:gravity="end"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvMyTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="12:00"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvMySender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="我"
                    android:textColor="#6B7280"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMyContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_bubble_me"
                android:maxWidth="260dp"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:text="我的文本"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/ivMyImage"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:adjustViewBounds="true"
                android:contentDescription="发送的图片"
                android:maxHeight="220dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivMyAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#E3F2FD"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher_round"
            android:contentDescription="我的头像" />
    </LinearLayout>

</LinearLayout>