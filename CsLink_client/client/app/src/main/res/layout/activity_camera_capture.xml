<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- CameraX 实时取景预览 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 拍摄完成后全屏确认预览图 -->
    <ImageView
        android:id="@+id/ivCapturedPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- 顶部提示条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="56dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#99000000"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="请将拍摄内容对准取景框"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 底部操作栏：矢量图标集成 -->
    <RelativeLayout
        android:id="@+id/layoutCameraBottomBar"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="bottom"
        android:background="#66000000"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <!-- 左侧：矢量关闭按钮 -->
        <ImageButton
            android:id="@+id/btnCameraBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭相机"
            android:src="@drawable/ic_camera_close"
            android:tint="#FFFFFF" />

        <!-- 中央：白色大快门拍照按钮 -->
        <Button
            android:id="@+id/btnShutter"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_centerInParent="true"
            android:backgroundTint="#FFFFFF"
            android:elevation="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp" />

        <!-- 右侧：矢量手电筒开关按钮 -->
        <ImageButton
            android:id="@+id/btnTorchToggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="手电筒开关"
            android:src="@drawable/ic_camera_flash"
            android:tint="#FFFFFF" />
    </RelativeLayout>

    <!-- 底部确认栏：拍完后的【重拍】与【发送到课堂】 -->
    <LinearLayout
        android:id="@+id/layoutConfirmControls"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="bottom"
        android:background="#99000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnRetake"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:backgroundTint="#4B5563"
            android:text="重拍"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnConfirmSend"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:backgroundTint="#1E88E5"
            android:text="发送到课堂"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

</FrameLayout>